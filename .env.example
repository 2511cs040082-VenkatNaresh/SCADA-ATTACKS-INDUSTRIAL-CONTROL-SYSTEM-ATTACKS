# ==============================================================================
# ICS-SHIELD — MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# Real-Time SCADA & Industrial Control System Attack Detection & Defense Platform
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & SYSTEM INFORMATION
# ------------------------------------------------------------------------------
NODE_ENV=production
APP_NAME=ICS-SHIELD
APP_VERSION=1.0.0
APP_PORT=5050
HOST=0.0.0.0
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 2. DATABASE CONFIGURATION (MySQL 8.0)
# ------------------------------------------------------------------------------
DATABASE_HOST=mysql
DATABASE_PORT=3306
DATABASE_NAME=ics_shield
DATABASE_USER=icsshield_user
DATABASE_PASSWORD=CHANGE_ME_SECURE_DB_PASSWORD_2026!
DATABASE_ROOT_PASSWORD=CHANGE_ME_SECURE_ROOT_PASSWORD_2026!
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_CONNECTION_TIMEOUT_MS=10000

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY HARDENING
# ------------------------------------------------------------------------------
JWT_SECRET=CHANGE_ME_HS256_JWT_SECRET_KEY_MINIMUM_32_CHARS_LONG!
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=CHANGE_ME_REFRESH_TOKEN_SECRET_MINIMUM_32_CHARS!
JWT_REFRESH_EXPIRES_IN=7d
SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX_REQUESTS=5
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ------------------------------------------------------------------------------
# 4. FRONTEND CONFIGURATION
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5050/api
VITE_WS_URL=ws://localhost:5050
VITE_APP_TITLE=ICS-SHIELD SOC Workspace

# ------------------------------------------------------------------------------
# 5. WEBSOCKET REAL-TIME ENGINE
# ------------------------------------------------------------------------------
WS_PORT=5050
WS_HEARTBEAT_INTERVAL_MS=30000
WS_CLIENT_TIMEOUT_MS=60000

# ------------------------------------------------------------------------------
# 6. TELEMETRY & PROTOCOL MONITORING PIPELINE
# ------------------------------------------------------------------------------
TELEMETRY_PORT=8086
NETWORK_MONITOR_PORT=8087
MODBUS_TCP_PORT=502
DNP3_PORT=20000
S7COMM_PORT=102
TELEMETRY_INGESTION_BATCH_SIZE=100
TELEMETRY_FLUSH_INTERVAL_MS=1000

# ------------------------------------------------------------------------------
# 7. DETECTION & MACHINE LEARNING ENGINE
# ------------------------------------------------------------------------------
DETECTION_SERVICE_URL=http://detection-engine:8080
RULE_ENGINE_COOLDOWN_SECONDS=300
BEHAVIORAL_ZSCORE_THRESHOLD=3.0
BEHAVIORAL_WINDOW_SIZE=100
ML_CONTAMINATION_RATE=0.05
ML_INFERENCE_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 8. ALERT & INCIDENT MANAGEMENT
# ------------------------------------------------------------------------------
ALERT_DEDUPLICATION_WINDOW_SEC=600
ALERT_AUTO_ESCALATE_SEVERITY=CRITICAL
INCIDENT_AUTO_ASSIGN_ROLE=SECURITY_ANALYST

# ------------------------------------------------------------------------------
# 9. MITRE ATT&CK FOR ICS INTEGRATION
# ------------------------------------------------------------------------------
MITRE_ATTACK_VERSION=v14
MITRE_DATASET_PATH=./data/mitre_attack_ics_v14.json
ALLOW_UNTRUSTED_MITRE_DOWNLOADS=false

# ------------------------------------------------------------------------------
# 10. DEFENSE & RESPONSE ENGINE
# ------------------------------------------------------------------------------
RESPONSE_SIMULATION_MODE=true
RESPONSE_REQUIRE_ADMIN_APPROVAL=true
RESPONSE_ENABLE_TWO_PERSON_RULE=true
ALLOW_UNLISTED_RESPONSE_ACTIONS=false

# ------------------------------------------------------------------------------
# 11. ISOLATED ICS LABORATORY SIMULATOR
# ------------------------------------------------------------------------------
ICS_LAB_SERVICE_URL=http://ics-lab:8085
ICS_LAB_ENVIRONMENT=LAB_SIMULATION
ALLOW_REAL_INFRASTRUCTURE_CONNECT=false
SIMULATION_SAFETY_GUARD_STRICT=true

# ------------------------------------------------------------------------------
# 12. REPORTS & ADVANCED ANALYTICS
# ------------------------------------------------------------------------------
REPORT_EXPORT_DIR=./exports/reports
REPORT_MAX_CUSTOM_RANGE_DAYS=90

# ------------------------------------------------------------------------------
# 13. DATA RETENTION & BACKUP
# ------------------------------------------------------------------------------
RETENTION_TELEMETRY_DAYS=30
RETENTION_SECURITY_EVENTS_DAYS=90
RETENTION_AUDIT_LOGS_DAYS=365
BACKUP_SCHEDULE_CRON="0 2 * * *"
BACKUP_STORAGE_DIR=./docker/backups
